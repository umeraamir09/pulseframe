# Onboard assistant. offline uses protocol cards in the browser (the default).
# live asks /api/assistant, then falls back to protocol cards if that call fails.
# Groq and OpenAI keys are server-only (Vercel env: GROQ_API_KEY, GROQ_MODEL, OPENAI_API_KEY). Never prefix them with VITE_.
VITE_ASSISTANT_MODE=offline
